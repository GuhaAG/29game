{
  "name": "twentynine",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based 29 - a private four-player card game that is played and forgotten (rulesVersion=1)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.js",
    "watch:client": "node scripts/build-client.js --watch",
    "start": "node dist/src/server/index.js",
    "dev": "npm run build && node dist/src/server/index.js",
    "test": "npm run build:server && node --test dist/test/engine dist/test/client dist/test/integration",
    "test:engine": "npm run build:server && node --test dist/test/engine",
    "test:client": "npm run build:server && node --test dist/test/client",
    "test:integration": "npm run build:server && node --test dist/test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2"
  }
}
