# Everything here is optional: with no configuration at all the server listens on
# port 3000 over plain HTTP, which is enough for a local game.
PORT=3000

# Behind TLS (any shared deployment) set all three:
# SECURE_COOKIES=1
# REQUIRE_HTTPS=1
# TRUST_PROXY=1
# ALLOWED_ORIGINS=https://your.host

# Language for all on-screen text: the name of a file in locales/ (default en).
# LOCALE=en

LOG_LEVEL=info

# Abuse limits (defaults shown).
# LIMIT_ROOM_CREATE=5
# LIMIT_ROOM_CREATE_WINDOW_MS=600000
# LIMIT_JOIN_ROOM_IP=10
# LIMIT_JOIN_IP=50
# LIMIT_COMMANDS_PER_SECOND=20
# LIMIT_COMMAND_BURST=40

# Timings in milliseconds (defaults shown).
# HEARTBEAT_MS=10000
# DISCONNECT_AFTER_MS=30000
# HOST_TRANSFER_AFTER_MS=60000
# ADMISSION_TTL_MS=300000
# RECOVERY_TTL_MS=300000
# LOBBY_IDLE_MS=1800000
# ACTIVE_IDLE_MS=7200000
# ABSOLUTE_LIFETIME_MS=86400000
# EXPIRY_WARNING_MS=300000
# PURGE_EXPIRED_AFTER_MS=300000
